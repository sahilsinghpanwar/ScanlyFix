{
  "name": "scanlyfix",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scan": "pnpm --filter @scanlyfix/cli exec tsx src/index.ts",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "razorpay:check": "node scripts/razorpay-preflight.mjs",
    "db:deploy": "pnpm --filter @scanlyfix/db db:deploy",
    "inngest:dev": "pnpm --filter @scanlyfix/web inngest:dev"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.2.0",
    "msw": "^2.15.0",
    "testcontainers": "^12.1.0",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@trpc/server": "^11.18.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.5.4"
  }
}
