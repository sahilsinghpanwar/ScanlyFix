# Postgres. The one variable every part of the app needs.
DATABASE_URL= postgresql://test:test@localhost:5432/test

# Supabase project. NEXT_PUBLIC_ values are inlined into the browser bundle at
# build time, so they are public by definition. The publishable key is the
# rate-limited, RLS-bound key safe to ship to the browser — never the
# service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<value>

# Production app URL — required. Must match "Site URL" in
# Supabase Auth → URL Configuration, and `${NEXT_PUBLIC_APP_URL}/auth/callback`
# must be on the Supabase redirect allowlist, otherwise every OAuth sign-in
# fails with redirect_uri_not_in_whitelist. Use http://localhost:3000 for local.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JSON array of redirect URIs this deployment will accept. Mirrors the
# Supabase dashboard's redirect allowlist; the proxy logs a one-line warning
# when the two diverge. The Supabase client refuses to redirect to anything
# not in its own allowlist — this is a deploy-time sanity check, not a
# security boundary.
SUPABASE_REDIRECT_ALLOWLIST=["https://example.com/auth/callback","http://localhost:3000/auth/callback"]

# Salt for hashing visitor addresses before they reach the database.
# 32+ bytes of random hex. Without one, an IPv4 hash is trivially reversed.
IP_HASH_SALT= test-salt-for-testing-only-32bytes-minimum

# Inngest event + signing keys, from inngest.com → your app → keys.
INNGEST_EVENT_KEY=signkey-dev-<...>
INNGEST_SIGNING_KEY=signkey-prod-<...>

# Razorpay. Absent until billing is configured.
RAZORPAY_KEY_ID=rzp_test_<...>
RAZORPAY_KEY_SECRET=<...>
RAZORPAY_PLAN_PRO_MONTHLY=plan_<...>
RAZORPAY_WEBHOOK_SECRET=#whsec_<...>
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_<...>

# PageSpeed Insights API key, for the CWV check. Optional.
PAGESPEED_API_KEY=<...>

# Browser-tier scanner, for Phase 6/8.
DARVIN_SCANNER_URL=http://127.0.0.1:8080
DARVIN_SCANNER_TOKEN=<...>

# Fix tier (AI fix prompts, apps/fixes). Both required together, and only used
# once set; without them the Fix buttons explain themselves. The token MUST
# match the SCANLYFIX_FIXES_TOKEN the fix tier was started with. The
# OPENROUTER_API_KEY lives in apps/fixes/.env — never here.
SCANLYFIX_FIXES_URL=http://127.0.0.1:8082
SCANLYFIX_FIXES_TOKEN=<...>

# Convex. Optional — only used for realtime features.
CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
NEXT_PUBLIC_CONVEX_URL=

# OAuth provider secrets for Supabase built-in providers.
AUTH_GITHUB_SECRET=<...>
AUTH_GOOGLE_SECRET=GOCSPX-<...>

# Resend, for transactional email. Optional.
AUTH_RESEND_KEY=re_<...>
