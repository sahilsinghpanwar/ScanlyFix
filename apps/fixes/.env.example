# The fix tier — turns one finding into the prompt that fixes it, via a model.
#
# Run with `pnpm --filter @scanlyfix/fixes start` (or the Docker image).
# The web app reaches it through SCANLYFIX_FIXES_URL / SCANLYFIX_FIXES_TOKEN
# (see apps/web/.env.example); without those the Fix button explains itself.

# OpenRouter key. Held by THIS service only — the web app never sees it.
# The process refuses to start without it.
OPENROUTER_API_KEY=sk-or-v1-...

# The model that writes the prompts. Defaults to the free MiniMax tier;
# override to trade latency and quality upward.
FIXES_MODEL=minimax/minimax-m3:free

# Shared secret the web backend must present. Generate one with
# `openssl rand -hex 24` — it MUST match SCANLYFIX_FIXES_TOKEN in the web app.
# The process refuses to start without it.
SCANLYFIX_FIXES_TOKEN=

# Port the service listens on. The default matches the web app's example URL.
PORT=8082
