DATABASE_URL=
# Salt for hashing visitor IP addresses before storage. Any long random string.
IP_HASH_SALT=

# Identity (Supabase Auth). Supabase proves who someone is; it is NOT the
# database — every scan, project and subscription lives in Postgres above.
#   NEXT_PUBLIC_SUPABASE_URL          the project's client URL, e.g.
#                                     https://your-ref.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  the publishable / anon key. Public
#                                     by definition; sent to the browser.
#                                     RLS in Postgres + the project-level API
#                                     key settings are what keep it safe.
#
# The provider secrets do not belong in this file either. Configure Google and
# GitHub in the Supabase dashboard (Authentication → Providers), not in
# `.env`. See SUPABASE_SETUP.md for the full flow.
#
# Email-code sign-in is enabled by default and uses Supabase's own email
# template — no Resend key needed in this app. To send branded emails instead,
# configure a custom SMTP provider in the Supabase dashboard.
#
# Redirect URL to register with Supabase OAuth apps (Authentication → URL
# Configuration, "Additional Redirect URLs"):
#   <SITE_URL>/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Billing (Phase 4, on Razorpay). Absent means upgrading is unavailable and
# every other part of the product still works.
#   KEY_ID / KEY_SECRET       Razorpay dashboard → Account & Settings → API Keys
#   PLAN_PRO_MONTHLY          Create a Plan (Subscriptions → Plans). The amount
#                             on THAT plan is what is actually charged — keep
#                             `priceMonthly` in apps/web/lib/plans.ts equal to it.
#
# Run `pnpm razorpay:check` after filling these in. Razorpay returns the same
# "Unauthorized" body for wrong credentials AND for a product the account has
# not enabled, so that script probes several endpoints and tells you which of
# the two you are looking at. Subscriptions is provisioned separately from
# payments and usually needs the account activated first.
#
#   WEBHOOK_SECRET            Settings → Webhooks. A DIFFERENT secret from the
#                             API one. Without it payments succeed and nobody is
#                             ever upgraded, so the webhook route logs loudly.
#                             Subscribe the endpoint to the subscription.* events
#                             at /api/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_WEBHOOK_SECRET=
# Where the customer returns after paying. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Monitoring (Phase 5). Leave unset in development — the client infers dev mode.
# Both are required in production, from the Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# PageSpeed Insights (Phase 6). Only used by `deep` scans, and skipped entirely
# when unset: without a key the shared anonymous quota is spent most of every
# day, so a keyless call is 30 seconds spent on a guaranteed 429. Free from the
# Google Cloud console with the PageSpeed Insights API enabled (25k/day).
PAGESPEED_API_KEY=

# Browser tier (Phase 6). Both required together, and only used by `deep`
# scans. Run the service with `pnpm --filter @scanlyfix/scanner start`; without
# these the rendered-DOM and axe-core checks stay silent.
# The token is a shared secret you choose — the service refuses to start
# without one, because it drives a real browser to any URL it is given.
#
# Also required for PDF export: the report is printed by the same Chromium that
# audits pages, so there is no PDF library to install. CSV and Markdown exports
# work without it.
SCANLYFIX_SCANNER_URL=
SCANLYFIX_SCANNER_TOKEN=

# Repo-scanner worker (GitHub repo scans). Both required together, and only
# used once set; without them repo scans fall back to a stub finding and every
# other feature still works. Run the service with
# `pnpm --filter @scanlyfix/github-scanner start` (or the Docker image in
# apps/github-scanner). In-cluster the URL is the worker Service, e.g.
# http://github-scanner.scanlyfix.svc.cluster.local:8081.
# The token is a shared secret you choose — generate one with
# `openssl rand -hex 24` — and it MUST match the SCANLYFIX_REPO_SCANNER_TOKEN
# the worker was started with. The worker refuses to start without it.
SCANLYFIX_REPO_SCANNER_URL=
SCANLYFIX_REPO_SCANNER_TOKEN=

# Fix tier (AI fix prompts). Both required together, and only used once set;
# without them the Fix buttons explain themselves and everything else still
# works. Run the service with `pnpm --filter @scanlyfix/fixes start` (or the
# Docker image in apps/fixes). In-cluster the URL is the service, e.g.
# http://fixes.scanlyfix.svc.cluster.local:8082. The token is a shared secret
# you choose — generate one with `openssl rand -hex 24` — and it MUST match
# the SCANLYFIX_FIXES_TOKEN the fix tier was started with. The fix tier holds
# the OPENROUTER_API_KEY itself; the web app never sees it.
SCANLYFIX_FIXES_URL=
SCANLYFIX_FIXES_TOKEN=

# Alert email (Phase 9). Without it the monitoring jobs still run and still
# record alerts, but nothing is delivered and lib/email.ts says so loudly on
# every attempt — an alerts row with a null sent_at is one nobody received.
#   RESEND_API_KEY     resend.com -> API Keys.
#   ALERT_FROM_EMAIL   A sender on a domain verified in Resend, e.g.
#                      "ScanlyFix <alerts@yourdomain.com>". Defaults to Resend's
#                      sandbox sender, which only ever delivers to the account
#                      owner's own address — fine for testing, useless in
#                      production, and visible as such rather than silent.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
