{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ALERT_FROM_EMAIL",
    "AUTH_GITHUB_SECRET",
    "AUTH_GOOGLE_SECRET",
    "AUTH_RESEND_KEY",
    "C_CONVEX_URL",
    "CONVEX_DEPLOYMENT",
    "CONVEX_DEPLOY_KEY",
    "CONVEX_URL",
    "DARVIN_SCANNER_TOKEN",
    "DARVIN_SCANNER_UR",
    "DARVIN_SCANNER_URL",
    "DATABASE_URL",
    "DEPLOY_HOOK_SECRET",
    "FIXES_MODEL",
    "GITHUB_APP_CLIENT_SECRET",
    "GITHUB_APP_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_APP_SLUG",
    "GITHUB_WEBHOOK_SECRET",
    "HEADER_ENCRYPTION_KEY",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "IP_HASH_SALT",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_VERCEL_URL",
    "OPENROUTER_API_KEY",
    "PAGESPEED_API_KEY",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RAZORPAY_PLAN_PRO_MONTHLY",
    "RAZORPAY_WEBHOOK_SECRET",
    "RESEND_API_KEY",
    "SCANLYFIX_FIXES_TOKEN",
    "SCANLYFIX_REPO_SCANNER_TOKEN",
    "SCANLYFIX_REPO_SCANNER_URL",
    "SCANLYFIX_SCANNER_TOKEN",
    "SCANLYFIX_SCANNER_URL",
    "SUPABASE_REDIRECT_ALLOWLIST",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL"
  ],
  "tasks": {
    "test": {
      "outputs": []
    },
    "test:unit": {
      "outputs": []
    },
    "test:integration": {
      "outputs": []
    },
    "test:e2e": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    }
  }
}